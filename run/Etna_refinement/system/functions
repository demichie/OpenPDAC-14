gradAlpha
{
    type            grad;
    libs            ("libfieldFunctionObjects.so");
    field           alpha.particles;
    executeControl  timeStep;
    writeControl    none;
}

magGradAlpha
{
    type            mag;
    libs            ("libfieldFunctionObjects.so");
    field           grad(alpha.particles);
    result          magGradAlpha;
    executeControl  timeStep;
    writeControl    adjustableRunTime;
    writeInterval   0.5;    
}


