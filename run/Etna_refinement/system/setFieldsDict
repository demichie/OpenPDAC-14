FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
			volScalarFieldValue alpha.gas 1.0
			volScalarFieldValue alpha.particles 0.0   
			volScalarFieldValue air.gas 0.99
			volScalarFieldValue H2O.gas 0.01
                        volScalarFieldValue T.gas 300.0
                        volScalarFieldValue T.particles 300.0
);

regions
(
	zoneToCell
	{
		zone "particle_source";
		fieldValues
		(
			volScalarFieldValue alpha.gas 0.8
			volScalarFieldValue alpha.particles 0.2   
                        volScalarFieldValue p 105200.0
		);
	}	
);


