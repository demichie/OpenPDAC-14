FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

massSource
{
    type            massSource;

    phase           particles;

    cellZone        particle_source;

    massFlowRate
    {
        type            scale;
        scale           squarePulse;
        start           0.0;
        duration        4.0;
        value           1e+8;
    }
}

