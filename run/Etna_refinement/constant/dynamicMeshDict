FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

topoChanger
{
    type            refiner;

    libs            ("libfvMeshTopoChangers.so");

    mover           none;

    // How often to refine
    refineInterval  40;

    // Field to be refinement on
    // field           alpha.particles;
    field           magGradAlpha;

    // Refine field in between lower..upper
    lowerRefineLevel 0.0001;
    upperRefineLevel 1.0;

    // Have slower than 2:1 refinement
    nBufferLayers   3;

    // Refine cells only up to maxRefinement levels
    maxRefinement   2;

    // Stop refinement if maxCells reached
    maxCells        650000;

    // Write the refinement level as a volScalarField
    dumpLevel       true;
    checkMesh       true;
}


distributor
{
    type            distributor;

    libs            ("libfvMeshDistributors.so");

    // Keep separate constraints for the Eulerian mesh load
    // and any additional cpuLoad fields
    multiConstraint         true;

    redistributionInterval  50;

    // Rebalance when the estimated CPU imbalance exceeds 10%
    maxImbalance            0.10;
}


