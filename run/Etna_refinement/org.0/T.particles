FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T.particles;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    "(top|atm)"
    {
        type            inletOutlet;
        phi             phi.particles;
        inletValue      uniform 300;
        value           uniform 300;
    }

    "(terrain)"
    {
        type            zeroGradient;
    }
}

sources
{
    massSource
    {
        type            uniformInletOutlet;
        uniformInletValue 600;
    }
}

// ************************************************************************* //
