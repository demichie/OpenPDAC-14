FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Theta.particles;
}
// ************************************************************************* //

dimensions          [0 2 -2 0 0 0 0];

internalField       uniform 0;

referenceLevel      1e-4;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    "(top|atm|terrain)"
    {
        type               zeroGradient;
    }
}

sources
{
    massSource
    {
        type            uniformInletOutlet;
        uniformInletValue 1e-4;
    }
}

// ************************************************************************* //
