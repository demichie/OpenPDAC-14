easyblock = 'Binary'

name = 'OpenPDAC'
version = '@VERSION@'
versionsuffix = '-OpenFOAM-14'

homepage = 'https://github.com/demichie/OpenPDAC-14'

description = """
OpenPDAC is an Eulerian-Lagrangian multiphase solver for the simulation
of pyroclastic density currents and related volcanic flows, developed
for OpenFOAM 14.
"""

toolchain = {'name': 'cpeGNU', 'version': '24.03'}

source_urls = [
    'https://github.com/demichie/OpenPDAC-14/archive/refs/tags'
]

sources = [{
    'download_filename': '@VERSION@.tar.gz',
    'filename':          'OpenPDAC-14-@VERSION@.tar.gz',
}]

# Force source extraction, needed with the Binary easyblock
extract_sources = True

# Strip the top-level GitHub archive directory
unpack_options = '--strip-components=1'

# This must match the actual OpenFOAM 14 module installed on LUMI.
dependencies = [
    ('OpenFOAM', '14'),
    # Alternatively:
    # ('OpenFOAM', '14', '-patch-20260710'),
]

buildininstalldir = False

preinstallopts = 'mkdir -p %(installdir)s/bin %(installdir)s/lib && '

install_cmd = """bash -c '
    set -e

    # The environment is prepared by the OpenFOAM dependency.
    export FOAM_USER_APPBIN=%(installdir)s/bin
    export FOAM_USER_LIBBIN=%(installdir)s/lib

    # --- STEP 1: Compile topoGrid ---
    echo "Starting compilation of topoGrid..."

    if [ -d applications/utilities/topoGrid ]; then
        cd applications/utilities/topoGrid
        wmake
        cd - > /dev/null
    else
        echo "ERROR: Directory applications/utilities/topoGrid not found!"
        echo "Current directory contents:"
        ls -la
        exit 1
    fi

    # --- STEP 2: Compile OpenPDAC ---
    echo "Starting compilation of OpenPDAC..."

    if [ -d applications/OpenPDAC ]; then
        cd applications/OpenPDAC

        if [ -f Allwmake ]; then
            chmod +x Allwmake
            ./Allwmake -j%(parallel)s
        else
            echo "ERROR: Allwmake not found in applications/OpenPDAC"
            exit 1
        fi
    else
        echo "ERROR: Directory applications/OpenPDAC not found!"
        exit 1
    fi
'"""

sanity_check_paths = {
    'files': [
        'bin/topoGrid',
        'lib/libOpenPDACSolver.so',
        'lib/libOpenPDACphaseSystem.so',
        'lib/libOpenPDACMomentumTransportModels.so',
    ],
    'dirs': [],
}

modextravars = {
    'FOAM_USER_APPBIN': '%(installdir)s/bin',
    'FOAM_USER_LIBBIN': '%(installdir)s/lib',
}

moduleclass = 'cae'
